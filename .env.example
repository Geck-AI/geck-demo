# Environment Configuration for THE STORE E-commerce Demo App

# Admin Authentication (Optional)
# These are used for admin-level access to the application
# If not set, only regular user authentication via users.json will work
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Development Settings
NODE_ENV=development
PORT=3005

# Next.js Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3005

# Database/Storage (if needed in future)
# DATABASE_URL=
# REDIS_URL=

# Geck tracking (for local dev, point to your backend)
# Used by app/api/tracking/collect and app/api/tracking/replay
# GECK_TRACKING_COLLECT_URL=http://localhost:3005/tracking/collect
# GECK_TRACKING_REPLAY_URL=http://localhost:3005/tracking/replay

# Tracker script proxy (app/api/geck-tracker)
# Defaults: GECK_TRACKER_URL=http://localhost:3005/tracker.js
#           NEXT_PUBLIC_GECK_BACKEND_URL=http://localhost:3005
# Override these if your Geck backend runs elsewhere:
# GECK_TRACKER_URL=https://api-dev.geck.ai/tracker.js
# NEXT_PUBLIC_GECK_BACKEND_URL=https://api-dev.geck.ai

# External APIs (if needed in future)
# OPENAI_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
